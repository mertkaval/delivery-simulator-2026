# Godot 4+ specific ignores
.godot/
/android/

# Local scratch output (captures, probes, backups)
/tmp/
# Blender autosave/backup copies
*.blend1
*.blend2
# Local tool settings
.claude/settings.local.json

# Baked editor preview of the city (regenerate: tools/bake_editor_preview.gd)
/world/editor_preview/city_preview.scn
/world/editor_preview/signature.txt

# Raw source packs the user drops in (converted copies live under assets/)
/source_assets/

# Local secrets (ElevenLabs API key etc.)
/.env
/.env.*
